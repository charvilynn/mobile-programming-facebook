# PaceBook Backend Environment Template
NODE_ENV=development
PORT=3000

# Database Configuration (MySQL / XAMPP / Laragon)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=uts_pacebook
DB_USER=root
DB_PASSWORD=

# JWT Secrets (Ganti di lingkungan produksi)
JWT_SECRET=pacebook_dev_secret_change_in_production_please
REFRESH_SECRET=pacebook_refresh_secret_change_in_production
JWT_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=30d

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8080